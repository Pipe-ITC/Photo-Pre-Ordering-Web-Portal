{
  "name": "photeam-festival-orders",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "deploy:build": "npm run deploy:check && prisma generate && prisma migrate deploy && next build",
    "deploy:check": "node scripts/check-production-env.mjs",
    "start": "next start",
    "start:migrate": "prisma migrate deploy && next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "next": "16.2.7",
    "prisma": "^6.7.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^18.1.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.2.7",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
