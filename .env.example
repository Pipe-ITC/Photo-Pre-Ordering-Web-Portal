# PostgreSQL connection string from Neon, Supabase, Railway, Render, or another host.
# Include sslmode=require when your provider requires TLS.
DATABASE_URL="postgresql://user:password@host:5432/photeam?sslmode=require"
NEXT_PUBLIC_SITE_URL="https://festivalphotos.pipeitc.dev"

# Application Server sync and private Vercel Blob
SYNC_CREDENTIAL="replace-with-a-random-secret-of-at-least-32-characters"
# Optional second credential used during rotation
SYNC_CREDENTIAL_NEXT=""
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Stripe live keys for production
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Prices are in pence
PRICE_MEDIUM_PRINT="1000"
PRICE_LARGE_PRINT="1500"
PRICE_MEDIUM_LARGE_BUNDLE="2000"
PRICE_FILLED_FRAME="4000"
PRICE_MEDAL_FRAME="4500"

# Admin area credentials
ADMIN_USERNAME="photeam"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-16-characters"
ADMIN_EMAIL="hello@photeam.co.uk"

# Mailgun email configuration
MAILGUN_API_KEY="key-..."
MAILGUN_DOMAIN="mg.photeam.co.uk"
MAILGUN_FROM="Photeam Orders <orders@mg.photeam.co.uk>"
# Use "EU" for an EU-region Mailgun domain, otherwise use "US"
MAILGUN_REGION="EU"

# Festival copy
NEXT_PUBLIC_FESTIVAL_NAME="Cornwall Football Festival"
NEXT_PUBLIC_COLLECTION_POINT="Photeam collection desk"

# Vercel Analytics page views are enabled by the app layout.
# Custom events may require a paid Vercel Analytics plan, so they are opt-in.
NEXT_PUBLIC_ENABLE_VERCEL_CUSTOM_EVENTS="false"
